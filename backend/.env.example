# کپی کنید به .env و مقادیر واقعی را بگذارید (فایل .env را هرگز commit نکنید)
PORT=5000
NODE_ENV=development

# رمز امضای توکن‌های ورود - در production حتماً یک رشته‌ی تصادفی بلند بگذارید
# (تولید: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
AUTH_SECRET=

# شماره موبایل مدیر کل (اگر خالی باشد از db.json خوانده می‌شود)
ADMIN_PHONE=

# پنل پیامک ملی‌پیامک (rest.payamak-panel.com)
# SMS_USERNAME: نام کاربری پنل ملی‌پیامک
# SMS_PASSWORD: APIKey از بخش تنظیمات → وب‌سرویس پنل ملی‌پیامک
# SMS_SENDER:   شماره فرستنده (مثال: 50004000004)
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER=

# آدرس‌های مجاز برای CORS (با کاما جدا کنید). اگر فرانت و بک‌اند روی یک دامنه‌اند خالی بگذارید.
CORS_ORIGINS=http://localhost:5173

# مبلغ هدیه معرف (تومان)
REFERRAL_REWARD=200000

# اگر پشت nginx/proxy هستید 1 بگذارید
TRUST_PROXY=0
